{
  "name": "casino-ops",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @casino-ops/api --filter @casino-ops/web dev",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up --build",
    "lint": "pnpm -r lint && eslint playwright.config.ts playwright.public.config.ts tests/e2e tests/public",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --config=playwright.public.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "video:capture": "node scripts/capture-demo.mjs",
    "test:ai": "pnpm run test:ai:build && pnpm run test:ai:infrastructure && pnpm run test:ai:investigation && pnpm run test:ai:brain && pnpm run test:ai:query",
    "test:ai:build": "pnpm --filter @casino-ops/shared build && pnpm --filter @casino-ops/agents build",
    "test:ai:brain": "node --env-file-if-exists=.env packages/agents/dist/smoke-test/brain-cli.js",
    "test:ai:infrastructure": "node --env-file-if-exists=.env packages/agents/dist/smoke-test/cli.js",
    "test:ai:investigation": "node --env-file-if-exists=.env packages/agents/dist/smoke-test/investigation-cli.js",
    "test:ai:query": "node --env-file-if-exists=.env packages/agents/dist/smoke-test/query-cli.js",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
