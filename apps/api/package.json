{
  "name": "@casino-ops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "cross-env NODE_OPTIONS=--conditions=development tsx watch src/server.ts",
    "lint": "eslint src",
    "start": "node dist/server.js",
    "test": "vitest run src --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@casino-ops/agents": "workspace:*",
    "@casino-ops/events": "workspace:*",
    "@casino-ops/shared": "workspace:*",
    "@casino-ops/simulator": "workspace:*",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": { "cross-env": "^10.1.0", "tsx": "^4.20.6", "vitest": "^4.0.3" }
}
